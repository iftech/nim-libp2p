+proc addRegistrar(
+    disco: ServiceDiscovery, serviceName: string, stream: FaultStream
+): PeerId =
+  ## One registrar in DiscT(service); every dial to it is answered by `stream`.
+  doAssert disco.registerInterest(serviceName)
